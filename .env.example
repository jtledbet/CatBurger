# ── Local development ──────────────────────────────────────────
# Copy this file to .env and fill in your local MySQL credentials.
# Never commit .env to git.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=catburger_db

# ── Production (Render + Railway) ──────────────────────────────
# On Render, set DATABASE_URL to your Railway MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=mysql://root:secret@containers-us-west-1.railway.app:6543/railway
